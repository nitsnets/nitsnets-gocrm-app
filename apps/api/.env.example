APP_NAME="NitsNets CRM API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nitsnets_crm
DB_USERNAME=nitsnets_crm
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
CACHE_STORE=database
MAIL_MAILER=log
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/gmail/callback
FRONTEND_URL=http://127.0.0.1:3000/?view=settings

# Login Google (openid/email/profile), separado de la conexión Gmail.
# ID/secret vacíos reutilizan GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
GOOGLE_LOGIN_WEB_RETURN_URI=http://127.0.0.1:3000/api/auth/google/callback
GOOGLE_LOGIN_IOS_RETURN_URI=com.nitsnets.crm://oauth/google
