# Laravel upstream, used by the BFF and /api/v1 proxy. Set before build and start.
# Must not point back to this Next.js origin (it would create a proxy loop).
CRM_API_URL=http://127.0.0.1:8000/api/v1
# true behind HTTPS in production; false only for local HTTP.
CRM_COOKIE_SECURE=false

# Optional exact public origin, recommended in production (e.g. https://crm.example.com).
# CRM_WEB_ORIGIN=http://127.0.0.1:3000

# Seeded local preview only. Set false before building/deploying real data.
NEXT_PUBLIC_CRM_DEMO=true
